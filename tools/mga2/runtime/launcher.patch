+static int find_pad_alias(const char *text) {
+    char compact[64];
+    size_t used = 0;
+    for (; *text && used + 1 < sizeof(compact); text++) {
+        unsigned char c = (unsigned char)*text;
+        if (c == ' ' || c == '_' || c == '-') continue;
+        compact[used++] = (char)tolower(c);
+    }
+    compact[used] = 0;
+    for (size_t i = 0; i < sizeof(s_pad_aliases) / sizeof(s_pad_aliases[0]); i++)
+        if (strcmp(compact, s_pad_aliases[i].name) == 0)
+            return s_pad_aliases[i].value;
+    return -1;
+}
