 }
 
+static void test_outline_direct_classification(void) {
+    GeState state;
+    memset(&state, 0, sizeof(state));
+    state.mga2_sharper_outline = 1;
+    state.fbp = 0x04000000u;
+    state.fbw = 512u;
+    state.fbfmt = 1u;
+    state.tex_enable = 1;
+    state.tex_addr = 0x04000000u;
+    state.tex_bufw = 512u;
+    state.tex_fmt = 6u;
+    state.tex_w = 512;
+    state.tex_h = 512;
+    state.clut_fmt = 0x13du;
+    state.stencil_test_enable = 1;
+    state.stencil_test = 0xff0002u;
+    if (!ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("alpha-only outline rejected from direct path");
+    if (ge_vk_shader_outline_direct_compatible(NULL, 4) ||
+        ge_vk_shader_outline_direct_compatible(&state, 1) ||
+        ge_vk_shader_outline_direct_compatible(&state, 9))
+        fail("invalid outline state or scale admitted");
+
+    state.mga2_sharper_outline = 0;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("non-outline admitted to outline direct path");
+    state.mga2_sharper_outline = 1;
+    state.blend_enable = 1;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("outline blending admitted to direct path");
+    state.blend_enable = 0;
+    state.logic_op_enable = 1;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("outline logic operation admitted to direct path");
+    state.logic_op_enable = 0;
+    state.mask_rgb = 1;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("outline RGB mask admitted to direct path");
+    state.mask_rgb = 0;
+    state.ztest_enable = 1;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("depth-tested outline admitted to direct path");
+    state.ztest_enable = 0;
+    for (unsigned shift = 0; shift <= 16; shift += 8) {
+        state.stencil_op = 1u << shift;
+        if (ge_vk_shader_outline_direct_compatible(&state, 4))
+            fail("stencil-mutating outline admitted to direct path");
+    }
+    state.stencil_op = 0u;
+    state.clut_fmt = 0x139u;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("RGB-indexed feedback admitted to direct path");
+    state.clut_fmt = 0x33du;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("multi-bit feedback admitted to direct path");
+    state.clut_fmt = 0x13du;
+    state.tex_addr += 2u;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("non-self feedback admitted to direct path");
+    state.tex_addr -= 2u;
+    state.tex_filter = 4u;
+    state.tex_max_level = 1;
+    if (ge_vk_shader_outline_direct_compatible(&state, 4))
+        fail("mipmapped feedback admitted to direct path");
+}
