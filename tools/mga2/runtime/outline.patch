+static int capture_target(Target *target) {
+    VkBufferImageCopy copy = {0};
+    uint8_t row[DRAW_W * SR_GRAPHICS_SCALE_MAX * 3u];
+    uint32_t width = DRAW_W * s_render_scale;
+    uint32_t height = FB_H * s_render_scale;
+    if (!s_capture_count) return 1;
+    if (!cmd_begin()) return 0;
+    to_layout(s_cmd, target->img, VK_IMAGE_ASPECT_COLOR_BIT, &target->layout,
+              VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    copy.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    copy.imageSubresource.layerCount = 1;
+    copy.imageExtent.width = render_width();
+    copy.imageExtent.height = height;
+    copy.imageExtent.depth = 1;
+    vkCmdCopyImageToBuffer(
+        s_cmd, target->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        s_xfer, 1, &copy);
+    {
+        VkBufferMemoryBarrier barrier = {
+            VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER
+        };
+        barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+        barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barrier.buffer = s_xfer;
+        barrier.size = VK_WHOLE_SIZE;
+        vkCmdPipelineBarrier(
+            s_cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+            0, 0, NULL, 1, &barrier, 0, NULL);
+    }
+    if (!cmd_submit_wait()) return 0;
+    for (uint32_t capture = 0; capture < s_capture_count; capture++) {
+        const char *path = s_capture_paths[capture];
+        FILE *file = fopen(path, "wb");
+        int ok = file != NULL;
+        if (ok) ok = fprintf(file, "P6\n%u %u\n255\n", width, height) > 0;
+        for (uint32_t y = 0; ok && y < height; y++) {
+            const uint8_t *source =
+                (const uint8_t *)s_xfer_map + (size_t)y * render_width() * 4u;
+            for (uint32_t x = 0; x < width; x++) {
+                row[x * 3u] = source[x * 4u];
+                row[x * 3u + 1u] = source[x * 4u + 1u];
+                row[x * 3u + 2u] = source[x * 4u + 2u];
+            }
+            ok = fwrite(row, 3u, width, file) == width;
+        }
+        if (file && fclose(file) != 0) ok = 0;
+        if (!ok) {
+            fprintf(stderr, "gegpu: failed to write capture %s\n", path);
+            s_capture_count = 0;
+            return 0;
+        }
+        fprintf(stderr, "gegpu: captured internal framebuffer -> %s\n", path);
+    }
+    s_capture_count = 0;
+    return 1;
+}
