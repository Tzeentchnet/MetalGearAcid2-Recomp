{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang-cl-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-cl",
      "displayName": "clang-cl (D3D12 + Vulkan, x64, Release)",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "MGA2_ENABLE_D3D12": "ON",
        "MGA2_ENABLE_VULKAN": "ON",
        "MGA2_FETCH_SDL3": "ON"
      }
    },
    {
      "name": "clang-cl-software",
      "displayName": "clang-cl (software reference, x64, Release)",
      "inherits": "clang-cl-base",
      "cacheVariables": {
        "MGA2_ENABLE_D3D12": "OFF",
        "MGA2_ENABLE_VULKAN": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-cl",
      "configurePreset": "clang-cl"
    },
    {
      "name": "clang-cl-software",
      "configurePreset": "clang-cl-software"
    }
  ]
}
