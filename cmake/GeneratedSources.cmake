function(mga2_read_generated_sources gen_dir output_var)
  set(manifest "${gen_dir}/mga2_generated_sources.txt")
  if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR
      "No generated source manifest in ${gen_dir}. Run tools/mga2/gen.py first.")
  endif()
  file(STRINGS "${manifest}" relative_sources)
  set(sources)
  set(main_chunk_found FALSE)
  set(main_register_found FALSE)
  set(native_found FALSE)
  foreach(relative_source IN LISTS relative_sources)
    if(relative_source MATCHES "^mga2_recomp_[0-9][0-9][0-9]\\.c$")
      set(main_chunk_found TRUE)
    elseif(relative_source STREQUAL "mga2_recomp_register.c")
      set(main_register_found TRUE)
    elseif(relative_source MATCHES
           "^modules/[A-Za-z0-9_]+/[A-Za-z0-9_]+_recomp_([0-9][0-9][0-9]|register)\\.c$")
      set(native_found TRUE)
    else()
      message(FATAL_ERROR "Invalid generated source manifest entry: ${relative_source}")
    endif()
    if(NOT EXISTS "${gen_dir}/${relative_source}")
      message(FATAL_ERROR "Missing generated source: ${gen_dir}/${relative_source}")
    endif()
    set(source "${gen_dir}/${relative_source}")
    if(source IN_LIST sources)
      message(FATAL_ERROR "Duplicate generated source: ${relative_source}")
    endif()
    list(APPEND sources "${source}")
  endforeach()
  if(NOT main_chunk_found OR NOT main_register_found OR NOT native_found)
    message(FATAL_ERROR
      "Generated source manifest is incomplete. Run tools/mga2/gen.py again.")
  endif()
  set(${output_var} "${sources}" PARENT_SCOPE)
endfunction()
